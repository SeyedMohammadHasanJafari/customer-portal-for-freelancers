# -------------------------------------------------------------
# Lumina Portal - Environment Configuration
# ---------------------------------------------
# Copy this file to .env and adjust variables as needed.
# -------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL - Neon, Supabase, or local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumina_portal?schema=public"

# NextAuth.js (Auth.js v5)
AUTH_SECRET="your-super-secret-auth-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Phase 2)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Stripe Payment Gateway (Test Mode - Phase 5)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend Email Service (Phase 4)
RESEND_API_KEY="re_..."
EMAIL_FROM="Lumina Portal <notifications@resend.dev>"
